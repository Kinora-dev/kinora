{
  "name": "@kinora/core",
  "type": "module",
  "version": "0.2.0",
  "description": "Shared contracts (zod schemas), helpers, and ingest client for kinora, the Playwright report dashboard",
  "author": "Joris Gallot",
  "license": "MIT",
  "homepage": "https://github.com/Kinora-dev/kinora#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kinora-dev/kinora.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/Kinora-dev/kinora/issues",
  "keywords": [
    "playwright",
    "test-report",
    "flaky-tests",
    "ci",
    "dashboard"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "prepublishOnly": "tsdown"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "tsdown": "^0.22.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.9"
  }
}
