{
  "name": "@kinora/core",
  "type": "module",
  "version": "0.1.0",
  "description": "Shared contracts (zod schemas), helpers, and ingest client for kinora, the Playwright report dashboard",
  "author": "Joris Gallot",
  "license": "MIT",
  "homepage": "https://github.com/joris-gallot/kinora#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joris-gallot/kinora.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/joris-gallot/kinora/issues",
  "keywords": [
    "playwright",
    "test-report",
    "flaky-tests",
    "ci",
    "dashboard"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "tsdown"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "tsdown": "^0.22.2",
    "typescript": "~6.0.2",
    "vitest": "^4.1.8"
  }
}
