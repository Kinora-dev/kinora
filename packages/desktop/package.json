{
  "name": "@kinora/desktop",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "kinora desktop: cloud dashboard + local Playwright trace viewer (Electron).",
  "author": "Joris Gallot",
  "license": "FSL-1.1-MIT",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsdown && vite build -c home/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "electron .",
    "dev": "pnpm build && electron .",
    "probe": "KINORA_DESKTOP_PROBE=1 electron .",
    "probe:home": "KINORA_HOME_PROBE=1 electron .",
    "dist:mac": "pnpm --filter @kinora/trace-viewer build && pnpm build && electron-builder --mac"
  },
  "dependencies": {
    "@kinora/core": "workspace:*",
    "@kinora/trace-viewer": "workspace:*",
    "@kinora/ui": "workspace:*",
    "@trpc/client": "^11.18.0",
    "electron-updater": "^6.8.9",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@kinora/server": "workspace:*",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.1",
    "tsdown": "^0.22.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
