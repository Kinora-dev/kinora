{
  "name": "@kinora/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "kinora desktop: local Playwright trace viewer (no account). Electron shell around @kinora/trace-viewer.",
  "author": "Joris Gallot",
  "license": "MIT",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsdown && vite build -c home/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "dev": "pnpm build && electron .",
    "probe": "KINORA_DESKTOP_PROBE=1 electron .",
    "probe:home": "KINORA_HOME_PROBE=1 electron .",
    "dist:mac": "pnpm --filter @kinora/trace-viewer build && pnpm build && electron-builder --mac"
  },
  "dependencies": {
    "@kinora/core": "workspace:*",
    "@kinora/server": "workspace:*",
    "@kinora/trace-viewer": "workspace:*",
    "@kinora/ui": "workspace:*",
    "@trpc/client": "^11.16.0",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "tailwindcss": "^4.3.0",
    "tsdown": "^0.22.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}
