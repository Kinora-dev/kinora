{
  "name": "@kinora/server",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Kinora backend: Hono + tRPC API (single-tenant, self-hostable)",
  "author": "Joris Gallot",
  "license": "AGPL-3.0-or-later",
  "exports": {
    ".": "./src/router/index.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.5.6",
    "@hono/node-server": "^2.0.4",
    "@hono/trpc-server": "^0.4.2",
    "@hono/zod-validator": "^0.7.6",
    "@kinora/core": "workspace:*",
    "@trpc/server": "^11.16.0",
    "better-auth": "^1.5.6",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2"
  }
}
