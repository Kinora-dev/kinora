{
  "name": "@playbackhq/trace-viewer",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright trace replay engine (vendored from microsoft/playwright, Apache-2.0) plus playback's own UI",
  "author": "Joris Gallot",
  "license": "MIT",
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:sw": "vite build --config vite.sw.config.ts",
    "dev": "pnpm build:sw && vite",
    "build": "pnpm build:sw && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.1",
    "@lezer/highlight": "^1.2.1",
    "@playbackhq/ui": "workspace:*",
    "@tanstack/vue-table": "^8.21.3",
    "@vueuse/core": "^14.3.0",
    "@zip.js/zip.js": "2.7.29",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.1",
    "lucide-vue-next": "^1.0.0",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.1.2"
  }
}
