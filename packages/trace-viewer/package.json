{
  "name": "@kinora/trace-viewer",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright trace replay engine (vendored from microsoft/playwright, Apache-2.0) plus kinora's own UI",
  "author": "Joris Gallot",
  "license": "MIT",
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "build:sw": "vite build --config vite.sw.config.ts",
    "dev": "pnpm build:sw && vite",
    "build": "pnpm build:sw && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@kinora/ui": "workspace:*",
    "@lezer/highlight": "^1.2.3",
    "@lucide/vue": "^1.21.0",
    "@sentry/vue": "^10.60.0",
    "@tanstack/vue-table": "^8.21.3",
    "@vueuse/core": "^14.3.0",
    "@zip.js/zip.js": "2.7.29",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.9",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  }
}
