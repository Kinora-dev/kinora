{
  "name": "@kinora/reporter",
  "type": "module",
  "version": "0.1.3",
  "description": "Playwright reporter that uploads test results to a kinora server",
  "author": "Joris Gallot",
  "license": "MIT",
  "homepage": "https://github.com/joris-gallot/kinora#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joris-gallot/kinora.git",
    "directory": "packages/reporter"
  },
  "bugs": "https://github.com/joris-gallot/kinora/issues",
  "keywords": [
    "playwright",
    "reporter",
    "test-report",
    "ci",
    "kinora"
  ],
  "exports": {
    ".": "./dist/index.mjs"
  },
  "main": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsdown"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "dependencies": {
    "@kinora/core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^26.0.0",
    "tsdown": "^0.22.3",
    "typescript": "~6.0.3"
  }
}
