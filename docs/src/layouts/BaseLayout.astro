---
import '@fontsource-variable/hanken-grotesk'
import '@fontsource-variable/jetbrains-mono'
import { SITE } from '../lib/site'
import '../styles/global.css'

interface Props {
  title: string
  description?: string
  robots?: string
}

const site = Astro.site ?? new URL(SITE.url)
const { title, description = SITE.description, robots = 'index,follow' } = Astro.props
const canonical = new URL(Astro.url.pathname, site).toString()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0b" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta property="og:site_name" content="kinora docs" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>
