{
  "name": "kinora",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "description": "A dashboard for your Playwright reports, across projects and over time",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": "24.12.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @kinora/web dev",
    "dev:viewer": "pnpm --filter @kinora/trace-viewer dev",
    "dev:server": "pnpm --filter @kinora/server dev",
    "build": "pnpm -r build",
    "preview:web": "pnpm --filter @kinora/web preview",
    "preview:viewer": "pnpm --filter @kinora/trace-viewer preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm -r test",
    "test:integration": "pnpm -r test:integration",
    "test:e2e": "pnpm -r test:e2e"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "eslint": "^10.3.0",
    "typescript": "~6.0.2"
  }
}
