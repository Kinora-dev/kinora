{
  "name": "playback",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "description": "A dashboard for your Playwright reports, across projects and over time",
  "engines": {
    "node": "24.12.0"
  },
  "scripts": {
    "dev:app": "pnpm --filter @playbackhq/app dev",
    "dev:viewer": "pnpm --filter @playbackhq/trace-viewer dev",
    "build:app": "pnpm --filter @playbackhq/app build",
    "build:viewer": "pnpm --filter @playbackhq/trace-viewer build",
    "build:cli": "pnpm --filter @playbackhq/cli build",
    "build:core": "pnpm --filter @playbackhq/core build",
    "preview:app": "pnpm --filter @playbackhq/app preview",
    "preview:viewer": "pnpm --filter @playbackhq/trace-viewer preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm -r test",
    "test:e2e:app": "pnpm --filter @playbackhq/app test:e2e",
    "test:e2e:viewer": "pnpm --filter @playbackhq/trace-viewer test:e2e",
    "ingest": "tsx packages/cli/src/playback.ts",
    "serve:rest": "tsx examples/rest-server.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@hono/node-server": "^2.0.4",
    "@playbackhq/core": "workspace:*",
    "eslint": "^10.3.0",
    "hono": "^4.12.23",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2"
  }
}
