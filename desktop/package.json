{
  "name": "@kinora/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "kinora desktop: local Playwright trace viewer (no account). Electron shell around @kinora/trace-viewer.",
  "author": "Joris Gallot",
  "license": "MIT",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "dev": "tsdown && electron .",
    "probe": "KINORA_DESKTOP_PROBE=1 electron .",
    "dist:mac": "pnpm -C .. --filter @kinora/trace-viewer build && pnpm build && electron-builder --mac"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "tsdown": "^0.22.2",
    "typescript": "~6.0.2"
  }
}
