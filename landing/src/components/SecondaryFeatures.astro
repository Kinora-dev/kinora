---
import {
  FingerprintPattern,
  GitBranch,
  GitCompareArrows,
  Server,
  Tags,
  Upload,
} from '@lucide/astro'

const items = [
  {
    icon: GitBranch,
    title: 'Branch & tag filters',
    body: 'Slice the overview by branch or tag to compare main against a feature branch, or smoke against nightly.',
  },
  {
    icon: Upload,
    title: 'Reporter or CLI',
    body: 'Auto-upload at the end of every run, or push an existing results.json from a separate CI job. Same data either way.',
  },
  {
    icon: FingerprintPattern,
    title: 'Stable test identity',
    body: 'A test keeps the same key across runs and ingest paths, so its history never silently breaks.',
  },
  {
    icon: GitCompareArrows,
    title: 'Run-to-run compare',
    body: 'Diff two runs and see what is newly failing, what got fixed, and what just turned flaky.',
  },
  {
    icon: Tags,
    title: 'Annotations surfaced',
    body: 'skip, fixme and slow annotations show up where they matter instead of hiding in the raw report.',
  },
  {
    icon: Server,
    title: 'Self-hosted, fair source',
    body: 'Your results stay on your own box. FSL server and dashboard, MIT client libraries you embed.',
  },
];
---

<section class="border-b border-border">
  <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-28">
    <header class="reveal mb-12 max-w-3xl">
      <p
        class="font-mono text-xs font-medium uppercase tracking-wider text-signal"
      >
        [ And the rest ]
      </p>
      <h2
        class="mt-4 text-balance text-3xl font-semibold tracking-tight sm:text-4xl"
      >
        Built like the tool you reach for daily.
      </h2>
    </header>

    <div
      class="grid gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        items.map((item, i) => {
          const Icon = item.icon
          return (
            <article
              class="reveal bg-background p-7"
              style={`--reveal-delay: ${(i % 3) * 70}ms`}
            >
              <span class="grid size-9 place-items-center rounded-md border border-border text-signal">
                <Icon class="size-4.5" aria-hidden="true" />
              </span>
              <h3 class="mt-4 text-base font-semibold tracking-tight">
                {item.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                {item.body}
              </p>
            </article>
          )
        })
      }
    </div>
  </div>
</section>
