# kinora self-host config (used by docker-compose.yml). Copy to .env and edit.

# Public URL where users reach kinora (this web container). Drives links, cookies, and artifact URLs.
# If you put kinora behind your own HTTPS proxy, set this to that public https URL.
PUBLIC_URL=http://localhost:8080
# Host port the web container binds to (match PUBLIC_URL).
WEB_PORT=8080

# Session secret. Generate one: openssl rand -hex 32
AUTH_SECRET=change-me-with-a-long-random-string

# Postgres (POSTGRES_HOST is set to the compose service automatically).
POSTGRES_USER=kinora
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kinora
POSTGRES_PORT=5432

# Self-host: keep cloud billing off, and the cookie host-only (single origin).
KINORA_CLOUD=false
COOKIE_DOMAIN=

# Social login (optional). Leave empty to use email + password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email (optional): enables verification, password reset, invitations, and alert emails.
# Any SMTP provider works (Resend, Brevo, SES, self-hosted). Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="kinora <no-reply@example.dev>"

# Artifact storage: leave S3_* empty to store trace.zip on a local volume (default).
# Set all five to use any S3-compatible store instead.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
